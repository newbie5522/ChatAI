# NewbieChat runtime configuration
# Required before first start:
# 1. HOST_PORT
# 2. ADMIN_PASSWORD
# 3. ADMIN_SECRET
#
# After deployment, open:
# http://YOUR_SERVER:HOST_PORT/#/admin
#
# Then configure Provider API Keys and create employee keys in the admin console.

# Host port used by Docker Compose.
HOST_PORT=3000

# Required for first admin login at /#/admin.
ADMIN_PASSWORD=

# Admin session signing secret. Use a long random string.
ADMIN_SECRET=

# Optional: server-side admin config path.
# Docker default: /app/.data/newbiechat-admin.json
# Local default: .data/newbiechat-admin.json
NEWBIE_ADMIN_CONFIG_PATH=

# Optional: server-side usage log path.
# Docker default: /app/.data/newbiechat-usage.json
# Local default: .data/newbiechat-usage.json
NEWBIE_USAGE_LOG_PATH=

# Optional: maximum local usage records retained in JSON storage.
USAGE_LOG_MAX_RECORDS=

# Optional bootstrap / fallback only.
# Do not use this as the normal employee management flow.
# Normal flow: create employee keys in /#/admin.
EMPLOYEE_ACCESS_KEYS=

# Optional Provider fallback only.
# Normal flow: configure Provider Keys in /#/admin > Provider Config.
OPENAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# Optional Provider base URLs.
BASE_URL=
GOOGLE_URL=
PERPLEXITY_BASE_URL=
ANTHROPIC_URL=
ANTHROPIC_API_VERSION=
OPENAI_ORG_ID=

# Optional additional Provider fallback only.
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_URL=
AI302_API_KEY=
AI302_URL=

# Optional proxy.
PROXY_URL=

# Optional legacy NextChat access password.
# Prefer NewbieChat employee keys created in /#/admin.
CODE=

# Optional user BYOK mode.
# Default is empty, meaning ordinary employees cannot bring their own Provider API Keys.
# Set to 1 only if you explicitly want to allow users to enter their own Provider Keys.
ALLOW_USER_PROVIDER_KEYS=

# Optional model and feature controls.
DISABLE_GPT4=
ENABLE_BALANCE_QUERY=
ALLOW_FAST_LINK_SETTINGS=
CUSTOM_MODELS=
DEFAULT_MODEL=
WHITE_WEBDAV_ENDPOINTS=
ENABLE_MCP=
