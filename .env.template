# NewbieChat startup configuration
#
# Business configuration is completed after deployment in /#/admin:
# - Provider API Keys
# - employee/admin accounts
# - quotas
# - model permissions

# Host port used by Docker Compose.
HOST_PORT=3100

# First-start bootstrap only.
# If no super_admin exists, NewbieChat creates one from these values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Session signing secret. Use a long random string.
ADMIN_SECRET=change-this-secret

# Optional: set to 1 only when accessing NewbieChat through HTTPS.
# Leave empty for direct HTTP VPS access such as http://IP:3100.
ADMIN_COOKIE_SECURE=

# Optional: server-side admin config path.
# Docker default: /app/.data/newbiechat-admin.json
# Local default: .data/newbiechat-admin.json
NEWBIE_ADMIN_CONFIG_PATH=

# Optional: server-side usage log path.
# Docker default: /app/.data/newbiechat-usage.json
# Local default: .data/newbiechat-usage.json
NEWBIE_USAGE_LOG_PATH=

# Optional: maximum local usage records retained in JSON storage.
USAGE_LOG_MAX_RECORDS=
